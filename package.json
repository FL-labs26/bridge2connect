{
  "name": "bridge2connect-website",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Bridge2Connect — modulaire, statisch opgebouwde website van Lex de Lange",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch --open",
    "start": "node scripts/serve.mjs --open",
    "preview": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/site.test.mjs tests/http.test.mjs tests/deploy.test.mjs tests/motion.test.mjs",
    "preflight": "node scripts/preflight.mjs"
  }
}
